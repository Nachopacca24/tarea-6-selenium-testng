<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="saucedemo" parallel="classes" thread-count="2">
  <parameter name="browser" value="chrome"/>

  <!-- Smoke: lo mínimo de login y carrito. -->
  <test name="smoke">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="edu.ufm.qa.tests.LoginTest"/>
      <class name="edu.ufm.qa.tests.CartTest"/>
    </classes>
  </test>

  <!-- Regresión solo del login, sin el caso de contraseña incorrecta. -->
  <test name="login-regression">
    <groups>
      <run>
        <include name="regression"/>
        <exclude name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="edu.ufm.qa.tests.LoginTest">
        <methods>
          <exclude name="wrongPasswordSeesError"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>
